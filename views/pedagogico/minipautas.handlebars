<div class="container">
    <div class="row">
        <div class="col-10 text-primary  h3">Todas Minipautas</div>
        {{#if autorizado}}
        <div class="col-2"><a href="/pedagogico/novoCurso" class="nav-link text-primary text-end">+ Novo</a></div>
        {{else}} {{/if}}
    </div>
    <hr class="py-1 bg-primary table">

    <table class="table">
        <thead class="fw-bold">
            <td class="text-center">N/O</td>
            <td>Nome da Escola</td>
            <td>Nome do Professor</td>
            <td>Classe</td>
            <td class="text-center">Turma</td>
            <td class="text-center">Alunos</td>
        </thead>

        <tbody>
            {{#each minipautas}}
            <tr>
                <td class="text-center"> {{numOrdem}} </td>
                <td> {{nomeEscola}} </td>
                <td> {{idProfessor.nome}} </td>
                <td> {{classe}} </td>
                <td class="text-center"> {{turma}} </td>
                <td class="text-center"> {{alunos.length}} </td>
                <td><a href="/pedagogico/curso/{{_id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            class="bi bi-eye" viewBox="0 0 16 16">
                            <path
                                d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                            <path
                                d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                        </svg>
                    </a></td>
            </tr>
            {{else}}
            <div class="text-center text-danger">Sem Cursos cadastrado</div>
            {{/each}}
        </tbody>
    </table>
</div>