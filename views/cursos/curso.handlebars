<div class="row">
    <div class="col-8">
        <div class="h3 text-primary"> Curso de {{curso.nomeCurso}} </div>

    </div>
    <div class="col-4">
        Código: {{curso.codigo}}
    </div>
</div>
<hr>
<div class="row accordion" id="accordionExample">

    {{!-- TURMAS --}}
    <div class="col-4">
        <div class="accordion-item">
            <h2 class="accordion-header bg-secondary">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                    aria-expanded="true" aria-controls="collapseOne">
                    Turmas
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <table class="table table-sm">
                        <thead class="bg-light  fw-bold">
                            <tr>
                                <td>Código</td>
                                <td>Nome da Turma</td>
                                <td class="text-center">Matriculados</td>
                                <td></td>
                            </tr>
                        </thead>
                        {{#each turmas}}
                        <tr>
                            <td> {{codigo}} </td>
                            <td> {{nomeTurma}} </td>
                            <td class="text-center"> {{matriculados}} </td>
                            <td><a href="/pedagogico/turma/{{_id}}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                                </a></td>
                        </tr>
                        {{else}}
                        <div class="text-center">Não ha nenhuma turma neste curso</div>
                        {{/each}}
                    </table>
                    {{#if autorizado}}
                    <div class="text-center mt-3">
                        <a href="#" onclick="adTurma()" class="btn btn-sm btn-primary">Adicionar Turma</a>
                    </div>
                    {{else}} {{/if}}
                </div>
            </div>
        </div>
    </div>
    {{!-- MODULOS --}}
    <div class="col-4">
        <div class="accordion-item">
            <h2 class="accordion-header bg-secondary">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                    aria-expanded="true" aria-controls="collapseTwo">
                    Modulos
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <table class="table table-sm">
                        <thead class="bg-light  fw-bold">
                            <tr>
                                <td>Código</td>
                                <td>Nome do Modulo</td>
                                <td></td>
                            </tr>
                        </thead>
                        {{#each modulos}}
                        <tr>
                            <td> {{codigo}} </td>
                            <td> {{nomeModulo}} </td>
                            <td><a href="/pedagogico/modulo/{{_id}}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                                </a></td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="2" class="text-center">Não ha nenhum Modulo neste curso</td>
                        </tr>
                        {{/each}}
                    </table>
                    {{#if autorizado}}
                    <div class="text-center mt-3">
                        <a href="#" onclick="adModulo()" class="btn btn-sm btn-secondary">Adicionar Modulo</a>
                    </div>
                    {{else}} {{/if}}
                </div>
            </div>
        </div>
    </div>

    {{!-- FORMADORES --}}
    <div class="col-4">
        <div class="accordion-item">
            <h2 class="accordion-header bg-secondary">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo"
                    aria-expanded="true" aria-controls="collapseTwo">
                    Formadores
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <table class="table table-sm">
                        <thead class="bg-light  fw-bold">
                            <tr>
                                <td>N/O</td>
                                <td>Nome do Formador</td>
                                <td></td>
                            </tr>
                        </thead>
                        {{#each formadores}}
                        <tr>
                            <td> {{numOrdem}} </td>
                            <td> {{nome}} </td>
                            <td><a href="/pedagogico/modulo/{{_id}}">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                                </a></td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="2" class="text-center">Não ha nenhum Formador neste curso</td>
                        </tr>
                        {{/each}}
                    </table>

                </div>
            </div>
        </div>
    </div>
</div>

<hr>
<div class="text-end mt-3">
    <a href="#" onclick="editCurso()" class="btn btn-sm btn-primary">Editar Curso</a>
    <a href="#" onclick="deleteCurso()" class="btn btn-sm btn-danger">Eliminar Curso</a>
    <a href="/pedagogico/listaCurso/{{curso._id}}" class="btn btn-sm btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye"
            viewBox="0 0 16 16">
            <path
                d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
            <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
        </svg> &shy; Ver Lista dos Formandos</a>
</div>





<!-- Modal Adicionar Turma-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="adTurma">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title text-primary">Adicionar Nova Turma</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/pedagogico/adTurma" method="post" class="p-3">

                <div class="row">
                    <div class="col-6">
                        <label for="codigo">Código</label>
                        <input type="text" name="codigo" id="codigo" class="form-control" required>
                    </div>
                    <div class="col-6">
                        <label for="nomeTurma">Nome da Turma</label>
                        <input type="text" name="nomeTurma" id="nomeTurma" class="form-control" required>
                    </div>

                    {{!-- Datas início e termino --}}
                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="dataInicio">Data de início</label>
                            <input type="date" name="dataInicio" id="dataInicio" class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label for="dataFim">Data de termino</label>
                            <input type="date" name="dataFim" id="dataFim" class="form-control" required>
                        </div>
                    </div>

                    {{!-- Centro --}}
                    <label for="centro" class="mt-2">Centro</label>
                    <input type="text" name="centro" id="centro" value="Centro de Formação Profissional do Andulo"
                        required class="form-control">
                </div>

                <div class="modal-footer text-center">
                    <input type="hidden" name="idCurso" value="{{curso._id}}">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Adicionar</button>

            </form>
        </div>
    </div>
</div>
</div>

<!-- Modal Adicionar Modulo-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="adModulo">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title text-primary">Novo Modulo</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/pedagogico/adModulo" method="post" class="p-3">

                <div class="row">
                    <div class="col-6">
                        <label for="codigo">Código</label>
                        <input type="text" name="codigo" id="codigo" class="form-control" required>
                    </div>
                    <div class="col-6">
                        <label for="nomeModulo">Nome do Modulo</label>
                        <input type="text" name="nomeModulo" id="nomeModulo" class="form-control" required>
                    </div>



                    {{!-- tempo --}}
                    <div class="col-4 offset-4">

                        <label for="tempoSemanal" class="mt-2">Tempo Semanal</label>
                        <input type="number" name="tempoSemanal" id="tempoSemanal" value="" required
                            class="form-control">
                    </div>
                </div>

                <div class="modal-footer text-center mt-3">
                    <input type="hidden" name="idCurso" value="{{curso._id}}">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Adicionar</button>

            </form>
        </div>
    </div>
</div>
</div>

<!-- Modal Editar Curso-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="editCurso">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title text-primary">Editar dados do Cursp</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/pedagogico/editCurso" method="post" class="p-3">


                <div class="mt-2">
                    <label for="nomeCurso">Nome do Curso</label>
                    <input type="text" name="nomeCurso" id="nomeCurso" value="{{curso.nomeCurso}}" class="form-control"
                        required>
                </div>
                <div class="mt-3">
                    <label for="familia">Família</label>
                    <input type="text" name="familia" id="familia" value="{{curso.familia}}" class="form-control"
                        required>
                </div>


                <div class="modal-footer text-center mt-3">
                    <input type="hidden" name="idCurso" value="{{curso._id}}">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar</button>

            </form>
        </div>
    </div>
</div>
</div>

<!-- Modal Deletar curso-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="deleteCurso">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title text-primary">Deletar Curso</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/pedagogico/deleteCurso" method="post" class="p-3">


                <div class="mt-2 text-center text-danger lead" >
                    Se eliminares este Curso, condicionará a Matrícula de todos formandos que se inscreveram nele, assim como as turmas vinculadas ao mesmo. Tem certeza que ainda quer apagar o Curso dde  <span class="fw-bold"> {{curso.nomeCurso}}</span> ?
                </div>


                <div class="modal-footer text-center mt-3">
                    <input type="hidden" name="nomeCurso" id="nomeCurso" value="{{curso.nomeCurso}}" class="form-control"
                        required>
                    <input type="hidden" name="idCurso" value="{{curso._id}}">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-sm btn-danger">Deletar</button>

            </form>
        </div>
    </div>
</div>
</div>


<script src="assets/bootstrap.bundle.min.js" class="img-fluid"></script>
<script>
    function adTurma() {

        let el = document.getElementById('adTurma');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }

    function adModulo() {

        let el = document.getElementById('adModulo');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }


    function editCurso() {
        let el = document.getElementById('editCurso');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }

    function deleteCurso() {
        let el = document.getElementById('deleteCurso');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }




</script>