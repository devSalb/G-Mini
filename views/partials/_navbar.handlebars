          <input type="email" name="email" class="form-control" required>

          <label for="telefone">Telefone</label>
          <input type="text" name="telefone" placeholder="Opcional" class="form-control text-end">

          <label for="senha">Senha</label>
          <input type="password" name="senha" id="senha1" class="form-control" required>
          
          <label for="senha2">Confirma a senha</label>
          <input type="password" name="senha2" onclick="aviso()" id="senha2" class="form-control" required>
          {{!-- <label for="aviso" id="aviso">....</label> --}}

          <input type="hidden" name="categoria" value="Professor">
          <input type="hidden" name="cliente" value="cliente">

        </div>

        <div class=" text-center mt-3">
          <input type="hidden" name="formandoNoCentro" value="não">
          <button type="submit" class="btn btn-sm btn-primary form-control">Continuar</button>
          <button type="button" class="btn btn-secondary btn-sm mt-2 form-control"
            data-bs-dismiss="modal">Cancelar</button>

