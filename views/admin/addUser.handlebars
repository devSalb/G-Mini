<div class="container  bg-light2">
    <div class="col-10 offset-1 myMt-0 mybox card p-2">

        {{#each erros}}
        <div class="alert alert-danger">{{texto}}</div>
        {{else}}
        {{/each}}
        {{!-- <form action="/usuario/add" method="post" enctype="multipart/form-data"> --}}
            <form action="/usuario/add" method="post">
                <div class="row ">

                    <div class=" p-3 px-5 fs2-1">


                        <div class="row mt-4">
                            <div class="col-6 h3 text-primary">Novo Utilizador</div>

                            {{!-- <div class="col-6 text-end">
                                <span>Foto</span>
                                <input type="file" name="fotoUser" id="">
                            </div> --}}
                        </div>
                        <div class="myMark px-2">
                            <span class="text-danger">!</span> O Utilizador terá de ter uma idade igual ou superior a 13
                            anos
                        </div>

                        <div class="row mt-3 ">
                            <div class="col-3">
                                <label for="id">ID<span class="text-danger">*</span> </label>
                                <input type="text" name="id" placeholder="A criar automáticamente" class="form-control"
                                    disabled>
                            </div>
                            <div class="col-3">
                                <label for="id">Número<span class="text-danger">*</span> </label>
                                <input type="text" name="numero" placeholder="A criar automáticamente"
                                    class="form-control" disabled>
                            </div>
                            <div class="col-6">
                                <label for="id">Nome<span class="text-danger">*</span> </label><br>
                                <input type="text" name="nome" placeholder="" class="form-control">
                            </div>
                        </div>

                        {{!-- Email, telefone e centro --}}
                        <div class="row mt-2">
                            <div class="col-3">
                                <label for="email">E-Mail<span class="text-danger">*</span></label>
                                <input type="text" name="email" placeholder="exemplo@gmail.com" class="form-control">
                            </div>
                            <div class="col-3">
                                <label for="telefone">Telefone</label>
                                <input type="text" name="telefone" placeholder="exemplo@gmail.com" class="form-control">
                            </div>
                            <div class="col-6">
                                <label for="centro">Centro<span class="text-danger">*</span></label>
                                <select name="centro" class="form-control">
                                    <option value="">Selecionar</option>
                                    <option value="Centro de Formação Profissional do Andulo">Centro de Formação
                                        Profissional do Andulo</option>

                                </select>
                            </div>
                        </div>

                        {{!-- Password, Perfil, Genero, Língua --}}
                        <div class="row mt-2">
                            <div class="col-3">
                                <label for="password">Password<span class="text-danger">*</span></label><br>
                                <input type="password" name="senha" class="form-control">
                            </div>

                            <div class="col-3">
                                <label for="password2">Confirma<span class="text-danger">*</span></label><br>
                                <input type="password" name="senha2" placeholder="Repete a senha" class="form-control">
                            </div>

                            <div class="col-3">
                                <label for="categoria">Perfil<span class="text-danger">*</span></label><br>
                                <select name="categoria" class="form-control">
                                    <option value="">Selecionar</option>
                                    <option value="admin">Admin</option>
                                    <option value="pedagogico">Pedagogico</option>
                                    {{!-- <option value="drAdministrativo">Dr Administrativo</option> --}}
                                    <option value="secretario">Secretário</option>
                                </select>
                            </div>

                            <div class="col-3">
                                <label for="genero">Genero<span class="text-danger">*</span></label><br>
                                <select name="genero" class="form-control">
                                    <option value="">Selecionar</option>
                                    <option value="F">Feminino</option>
                                    <option value="M">Masculino</option>
                                </select>
                            </div>

                        </div>

                        {{!-- Outros dados --}}

                        <div class="bg-secondary opacity-50 text-center text-light mt-4">A B L I T A Ç Õ E S</div>

                        <div class="row mt-2">
                            <div class="col-6">
                                <label for="nivelAvademico">Nível Académico</label>
                                <input type="text" name="nivelAcademico" class="form-control">
                            </div>
                            <div class="col-6">
                                <label for="area">Área</label>
                                <input type="text" name="area" class="form-control">
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-3">
                                <label for="instituicao">Instituição de Ensino</label>
                                <input type="text" name="instituicao" class="form-control">
                            </div>
                            <div class="col-3">
                                <label for="cusos">Cursos relevantes</label>
                                <input type="text" name="cursos" class="form-control">
                            </div>
                        </div>
                        <div class="card-body">





                        </div>
                        <div class="text-end">
                            <button type="submit" class="btn btn-primary mt-2 ">Cadastrar</button>
                            <a href="/user" class="btn btn-secondary mt-2">Cancelar</a>
                        </div>
                    </div>

                </div>
            </form>
    </div>

</div>