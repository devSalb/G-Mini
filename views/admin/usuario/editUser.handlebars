<div class="container">
    <div class="row">
        <div class="col-4 offset-4 mt-4">
            <h2 class="text-center opacity-50">Actualizar dados de Usuário</h2>
            <hr>
            {{#each erros}}
            <div class="alert alert-danger">{{texto}}</div>
            {{else}}
            {{/each}}
            <div class="card p-3">
                <div class="card-body">
                    <form action="/usuario/editUser" method="post">
                        {{#if user}}
                        <label for="username">Nome de Usuário:</label>
                        <input type="text" name="username" value="{{usuario.username}}" class="form-control" required>
                        <input type="password" name="novaSenha"  class="form-control mt-2" placeholder="Nova senha" required>
                        <input type="password" name="novaSenha2" class="form-control mt-2" placeholder="Repete a nova senha" required>
                        <label for="telefone">Telefone:</label>
                        <input type="text" name="telefone" value="{{usuario.telefone}}" class="form-control">
                        <label for="categoria">Categoria:</label>
                        <input type="text" name="categoria" disabled value="{{usuario.categoria}}" class="form-control">
                      
                        <input type="hidden" name="id" value="{{usuario._id}}">

                        <div class="text-center">
                            <button type="submit" class="btn btn-success mt-2 ">Actualizar</button>
                            <a href="/user/allusers" class="btn btn-warning mt-2">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
                        {{else}}
                        <h4>Faça login para Editar</h4>
                        {{/if}}