<div class="container">
    <div class="row">
        <div class=" text-center opacity-50"><h2>Usuarios do sistema</h2></div>
        {{!-- <div class="col-4 text-end"><a href="/admin/relUserSistema" class="btn bg-info text-light fw-bold">Relatorio de acesso ao sistema</a></div> --}}
    </div>
</div>
<hr>
<div class="text-center">
<a href="/usuario/add "><button class="btn btn-primary ">Adicionar usuário</button></a>
</div>
{{#each usuarios}}
<div class="card mt-2">
    <div class="card-body">
        <div class="h4">{{username}}</div>
            <p>{{categoria}}</p>
            

            <a href="/usuario/deletUser/{{_id}}"><button class="btn btn-danger btn-sm">Deletar</button></a>
            <a href="/usuario/editUser/{{_id}}"><button class="btn btn-primary btn-sm">Editar</button></a>
    </div>
</div>
{{else}}
    <div class="h3 mt-3 text-center">Nenhum usuário registrado</div>
{{/each}}
<div class="text-center">

<a href="/admin/listaUserPDF"><button class="btn btn-secondary " > Gerar lista de Usuarios Funcionarios PDF</button></a>
</div>