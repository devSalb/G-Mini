<div class="container  bg-light2">
    <div class="col-10 offset-1 myMt-0 mybox card p-2">

        {{#each erros}}
        <div class="alert alert-danger">{{texto}}</div>
        {{else}}
        {{/each}}
        {{!-- <form action="/rh/adFuncionario" method="post" enctype="multipart/form-data"> --}}
        <form action="/rh/adFuncionario" method="post">
            <div class="row ">

                <div class=" p-3 px-5 fs2-1">


                    <div class="row mt-4">
                        <div class="col-6 h3 text-primary">Cadastro de Funcionário  </div>
                        <div class="col-6 offset-3">

                        {{#each mesageErr}}
                        <div class="text-center text-danger mybg-danger mt-1"> {{texto}} </div>
                        {{else}}{{/each}}
                        </div>

                        {{!-- Carregamento de foto --}}
                       {{!--  <div class="col-6 text-end">
                            <span>Foto</span>
                            <input type="file" name="fotoUser" id="">
                        </div> --}}
                    </div>
                    <div class="myMark px-2">
                        <span class="text-danger">!</span> {{!-- O Utilizador terá de ter uma idade igual ou superior a 13
                        anos --}}
                    </div>

                    <div class="row mt-3 ">
                        <div class="col-3">
                            <label for="id">ID<span class="text-danger">*</span> </label>
                            <input type="text" name="id" value="{{id}}" placeholder="A criar automáticamente" class="form-control"
                                disabled>
                        </div>
                        <div class="col-3">
                            <label for="id">Número<span class="text-danger">*</span> </label>
                            <input type="text" name="numero" value="{{numero}}" placeholder="A criar automáticamente" class="form-control"
                                disabled>
                        </div>
                        <div class="col-6">
                            <label for="id">Nome<span class="text-danger">*</span> </label><br>
                            <input type="text" name="nome" value="{{nome}}" placeholder="" class="form-control" required>
                        </div>
                    </div>

                    {{!-- Email, telefone e centro --}}
                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="email">E-Mail<span class="text-danger">*</span></label>
                            <input type="text" name="email" value="{{email}}" placeholder="exemplo@gmail.com" class="form-control" required>
                        </div>
                        <div class="col-3">
                            <label for="telefone">Telefone</label>
                            <input type="text" name="telefone" value="{{telefone}}" placeholder="+244 9_ _ _ _ _ _ _ _" class="form-control">
                        </div>
                        <div class="col-6">
                            <label for="centro">Centro<span class="text-danger">*</span></label>
                            <select name="centro" class="form-control">
                                <option value="{{centro}}"> {{centro}} </option>
                                <option value="Andulo">Centro de Formação Profissional do Andulo</option>
                            </select>
                        </div>
                    </div>

                    {{!-- Password, Perfil, Genero, Língua --}}
                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="password">Password<span class="text-danger">*</span></label><br>
                            <input type="password" name="senha" value="{{senha}}" class="form-control" required>
                        </div>

                        <div class="col-3">
                            <label for="password2">Confirma<span class="text-danger">*</span></label><br>
                            <input type="password" name="senha2" value="{{senha2}}" placeholder="Repete a senha" class="form-control" required>
                        </div>

                        <div class="col-3">
                            <label for="categoria">Categoria<span class="text-danger">*</span></label><br>
                            <select name="categoria" class="form-control">
                                <option value="{{categoria}}"> {{categoria}} </option>
                                <option value="formador">Formador</option>
                                <option value="tecnicoAuxiliar">Tecnico auxiliar</option>
                                <option value="tecnicoAdministrativo">Tecnico administrativo</option>
                            </select>
                        </div>

                        <div class="col-3">
                            <label for="genero">Genero<span class="text-danger">*</span></label><br>
                            <select name="genero" class="form-control">
                                <option value="{{genero}}"> {{genero}} </option>
                                <option value="F">Feminino</option>
                                <option value="M">Masculino</option>
                            </select>
                        </div>

                    </div>
                    {{!-- BI, nascimento --}}
                    <div class="row mt-3">
                        <div class="col-3">
                            <label for="bi">BI<span class="text-danger">*</span></label><br>
                            <input type="text" name="numBI" value="{{numBI}}" class="form-control" required>
                        </div>

                        <div class="col-3">
                            <label for="dataNascimento">Data de Nascimento<span class="text-danger">*</span></label><br>
                            <input type="date" name="dataNascimento" value="{{dataNascimento}}" placeholder="Apenas o ano" class="form-control">
                        </div>

                        <div class="col-3">
                            <label for="morada">Morada</label><br>
                            <input type="text" name="morada" value="{{morada}}" class="form-control">
                        </div>

                        <div class="col-3">
                            <label for="estadoCivil">Estado Civil<span class="text-danger">*</span></label><br>
                            <select name="estadoCivil" class="form-control">
                                <option value="{{estadoCivil}}"> {{estadoCivil}} </option>
                                <option value="casado">Casado(a)</option>
                                <option value="solteiro">Solteiro(a)</option>
                            </select>
                        </div>

                    </div>

                    {{!-- Outros dados --}}

                    <div class="bg-secondary opacity-50 text-center text-light mt-4">A B L I T A Ç Õ E S</div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="nivelAvademico">Nível Académico<span class="text-danger">*</span></label>
                            <select name="nivelAcademico" class="form-control">
                                <option value="{{nivelAcademico}}"> {{nivelAcademico}} </option>
                                <option value="medio">Tec. Médio</option>
                                <option value="licenciado">Licenciado</option>
                                <option value="pos-graduacao">Pós-Graduação</option>
                                <option value="mestre">Mestre</option>
                                <option value="doutor">Doutor</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label for="area">Área de Formação<span class="text-danger">*</span></label>
                            <input type="text" name="areaFormacao" value="{{areaFormacao}}" class="form-control">
                        </div>
                    </div>
                    
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary mt-2 ">Cadastrar</button>
                        <a href="/user" class="btn btn-secondary mt-2">Cancelar</a>
                    </div>
                </div>

            </div>
        </form>
    </div>

</div>