             <div class="col-4 text-end">
        <a href="#" onclick="eliminarFormando()" class="btn btn-sm btn-danger mx-2">Eliminar</a>
        <a href="/pedagogico/editarFormando/{{formando._id}}"><button class="btn btn-sm btn-success">Editar</button></a>
