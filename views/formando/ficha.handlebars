<!-- Modal Eliminar ficha/aluno-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="eliminarFormando">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Eliminar ficha</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="text-danger lead p-3 text-center">Tem certeza que deseja eliminar os dados de <span
                    class="text-primary"> {{formando.nome}}</span>? </div>

            <div class="modal-footer text-center">
                <form action="/pedagogico/eliminarFormando" method="post">
                    <input type="hidden" name="idFormando" value="{{formando._id}}">
                    <input type="hidden" name="idUser" value="{{formando.usuario}}">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Feichar</button>
                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>

                </form>
            </div>
        </div>
    </div>
</div>


<script src="assets/bootstrap.bundle.min.js" class="img-fluid"></script>
<script>
    function eliminarFormando() {

        let el = document.getElementById('eliminarFormando');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }




</script>