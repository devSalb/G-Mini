{{!-- Caso a conta do formando não estiver autirizada, não terá acesso a outras informaçõe --}}

{{#if autorizado}}{{!-- Se for autorizado --}}
<div class="conteiner">
    <div class="h3 text-center">Ficha do Formando</div>
    <hr class="p-1 bg-primary">
    <div class="row">
        <div class="col-5"></div>
        <div class="col-5">
            <p>Número: {{formando.numero}} </p>
            <p>Nome: {{formando.nome}} </p>
            <p>Curso: {{formando.curso}} </p>
            <p>Turma: {{formando.turma}} </p>
            <p>Nº Doc: {{formando.numBI}} </p>
            <p>Idade: {{formando.idade}} anos</p>
        </div>
        <div class="col-2 text-end">
            <div class="card-body mx-0">
                <img src="/img/modelofoto.png" class="fotoAluno" alt="Foto de formando">
            </div>

        </div>
    </div>
    <hr>
    <div class="accordion" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header bg-secondary">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne"
                    aria-expanded="true" aria-controls="collapseOne">
                    Informações Pessoais
                </button>
            </h2>
            <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="naturalidade">Naturalidade</label>
                            <input type="text" name="naturalidade" value="{{formando.naturalidade}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="dataNascimento">Data de Nascimento <code>*</code></label>
                            <input type="text" name="dataNascimento" value="{{formando.dataNascimento}}"
                                class="form-control text" required>
                        </div>
                        <div class="col-3">
                            <label for="nacionalidade">Nacionalidade <code>*</code></label>
                            <input type="text" name="nacionalidade" value="{{formando.nacionalidade}}"
                                class="form-control" required>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="tipoDocumento">Tipo de Documento</label>
                            <select name="tipoDocumento" class="form-control">
                                <option value="{{formando.tipoDocumento}}"> {{formando.tipoDocumento}} </option>
                                <option value="BI">Bilhete de Identidade</option>
                                <option value="passaporte">Passaporte</option>
                            </select>
                        </div>
                        <div class="col-3">
                            <label for="numBI">Nº Documento <code>*</code></label>
                            <input type="text" name="numBI" value="{{formando.numBI}}" class="form-control" required>
                        </div>
                        <div class="col-3">
                            <label for="numContribuinte">Nº Contribuinte</label>
                            <input type="text" name="numContribuinte" value="{{formando.numContribuinte}}"
                                class="form-control">
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="dataEmissaoBI">Data de Emissão</label>
                            <input type="date" name="dataEmissaoBI" value="{{formando.dataEmissaoBI}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="dataValidadeBI">Data de Validade</label>
                            <input type="date" name="dataValidadeBI" value="{{formando.dataValidadeBI}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="arquivo">Arquivo</label>
                            <input type="text" name="arquivo" value="{{formando.arquivo}}" class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="estadoCivil">Estado Civil </label>
                            <select name="estadoCivil" class="form-control">
                                <option value="{{formando.estadoCivil}}"> {{formando.estadoCivil}} </option>
                                <option value="casado">Casado</option>
                                <option value="solteiro">Solteiro</option>
                            </select>
                        </div>
                    </div>

                    <div class="row my-2">
                        <div class="col-6">
                            <label for="necessidadeEspecial">Necessidades Especiais</label>
                            <select name="necessidadeEspecial" class="form-control">
                                <option value="{{formando.necessidadeEspecial}}"> {{formando.necessidadeEspecial}}
                                </option>
                                {{!-- <option value="não">Não, não tenho nenhumma necessidade especial</option>
                                <option value="sim">Sim, tenho umma necessidade especial</option> --}}
                            </select>
                        </div>
                        <div class="col-6 ">
                            <label for="descricaoNEE">Descrição das Nessecidades Especiais</label>
                            <input type="text" name="descricaoNEE" value="{{formando.descricaoNEE}}"
                                class="form-control">
                        </div>
                    </div>
                    <label for="outInfPessoais">Outras informações Pessoais</label>
                    <input type="text" name="outInfPessoais" value="{{formando.outInfPessoais}}" class="form-control">
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    Informações Profissionais
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    {{!-- Informações Profissionais --}}
                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="dataAdmissao">Data de Admissão</label>
                            <input type="date" name="dataAdmissao" value="{{dataAdmissao}}" class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="dataSaida">Data de Saida</label>
                            <input type="date" name="dataSaida" value="{{formando.dataSaida}}" class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="inicioCarreiraP">Início na Carreira Profissional</label>
                            <input type="date" name="inicioCarreiraP" value="{{formando.inicioCarreiraP}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="ultimoActEmpregador">Último/Actual Empregador</label>
                            <input type="text" name="ultimoActEmpregador" value="{{formando.ultimoActEmpregador}}"
                                class="form-control">
                        </div>
                    </div>
                    {{!-- --}}
                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="carteiraProf">Carteira Profissional</label>
                            <select name="carteiraProf" class="form-control">
                                <option value="{{formando.carteiraProf}}"> {{formando.carteiraProf}} </option>
                                {{!-- <option value="não Possui">Não Possui</option>
                                <option value="possui">Possui</option> --}}

                            </select>
                        </div>
                        <div class="col-3">
                            <label for="especialidade">Especialidade</label>
                            <input type="text" name="especialidade" value="{{formando.especialidade}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="grupoProfissional">Grupo Profissional</label>
                            <input type="text" name="grupoProfissional" value="{{formando.grupoProfissional}}"
                                class="form-control">
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                    Hablitações
                </button>
            </h2>
            <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    {{!-- Hablitações --}}
                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="nivelAcademico">Nível Académico <code>*</code></label>
                            <input type="text" name="nivelAcademico" value="{{formando.nivelAcademico}}"
                                class="form-control" required>
                        </div>
                        <div class="col-6">
                            <label for="areaFormacao">Área</label>
                            <input type="text" name="areaFormacao" value="{{formando.areaFormacao}}"
                                class="form-control">
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-3">
                            <label for="instituicaoEnsino">Instituição de Ensino <code>*</code></label>
                            <input type="text" name="instituicaoEnsino" value="{{formando.instituicaoEnsino}}"
                                class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="cursosReferentes">Cursos Relevantes</label>
                            <input type="text" name="cursosReferentes" value="{{formando.cursosReferentes}}"
                                class="form-control">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#flush-collapseFour" aria-expanded="false" aria-controls="flush-collapseFour">
                    Contactos
                </button>
            </h2>
            <div id="flush-collapseFour" class="accordion-collapse collapse" data-bs-parent="#accordionFlushExample">
                <div class="accordion-body">
                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="email">E-Mail</label>
                            <input type="text" name="email" value="{{usuario.username}}" class="form-control">

                        </div>
                        <div class="col-3">
                            <label for="telefixo">Telefone Fixo</label>
                            <input type="text" name="telefixo" value="{{formando.telefixo}}" class="form-control">
                        </div>
                        <div class="col-3">
                            <label for="telefone2">Telemóvel 2</label>
                            <input type="text" name="telefone2" value="{{formando.telefone2}}" class="form-control">
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="provincia">Província <code>*</code></label>
                            <input type="text" name="provincia" value="{{formando.provincia}}" class="form-control"
                                required>
                        </div>
                        <div class="col-6">
                            <label for="municipio">Município <code>*</code></label>
                            <input type="text" name="municipio" value="{{formando.municipio}}" class="form-control"
                                required>
                        </div>
                    </div>

                    <div class="row mt-2">
                        <div class="col-6">
                            <label for="endereco">Endereço <code>*</code></label>
                            <input type="text" name="endereco" value="{{formando.endereco}}" class="form-control"
                                required>
                        </div>
                        <div class="col-3">
                            <label for="bairro">Bairro <code>*</code></label>
                            <input type="text" name="bairro" value="{{formando.bairro}}" class="form-control" required>
                        </div>
                        <div class="col-3">
                            <label for="localidade">Localidade <code>*</code></label>
                            <input type="text" name="localidade" value="{{formando.localidade}}" class="form-control"
                                required>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {{#if formando.candidato}}
    {{else}}
    <hr>

    {{!-- Candidato aceite --}}
    <div class="h4 text-center">Formadores / Modulos</div>
    <div class="accordion" id="accordionExample">
        <div class="accordion-item">
            <h2 class="accordion-header text-center">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                    data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                    Confira aqui as notas das Avaliações
                </button>
            </h2>
            <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                <div class="accordion-body">
                    {{!-- Notas de avaliações --}}
                    <div class="display-2 text-center p-5">Notas</div>
                </div>
            </div>
        </div>

    </div>
    {{/if}}
    <hr>
    {{#if autorizado}} {{!-- Se tiver autorização fará estas operações --}}

    <div class=" text-center mt-3">
        {{#if formando.candidato}}
        {{!-- Documentação - candidatura--}}
        <div class="row">
            <div class="col-8">
                <div class="row">
                    <div class="col-2 card">
                        Fotografia {{#if formando.foto}} 
                        <a href="/pedagogico/verFoto/{{formando._id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                        </a>
                        {{else}} <code>X</code>{{/if}}
                    </div>
                    <div class="col-2 card">
                        Bilhete{{#if formando.bilhete}} 
                        <a href="/pedagogico/verBI/{{formando._id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                        </a>
                        {{else}} <code>X</code>{{/if}}
                    </div>
                    <div class="col-2 card">
                        Certificado{{#if formando.certificado}} 
                        <a href="/pedagogico/verCertificado/{{formando._id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                        </a>
                        {{else}} <code>X</code>{{/if}}
                    </div>
                </div>
                
            </div>
            <div class="col-4 text-end mt-2">
        <a href="/pedagogico/autorizarcandidatura/{{formando._id}}"><button class="btn btn-sm btn-success">Autorizar
                Candidatura</button></a>
            </div>
        </div>
        
        {{else}}
        {{!-- Documentação Candidatura aceite --}}
        <div class="row">
            <div class="col-6">
                <div class="row">
                    <div class="col-2 card">
                        Fotografia {{#if formando.foto}} 
                        <a href="/pedagogico/verFoto/{{formando._id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                        </a>
                        {{else}} <code>X</code>{{/if}}
                    </div>
                    <div class="col-2 card">
                        Bilhete{{#if formando.bilhete}} 
                        <a href="/pedagogico/verBI/{{formando._id}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor"
                                        class="bi bi-eye" viewBox="0 0 16 16">
                                        <path
                                            d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13 13 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5s3.879 1.168 5.168 2.457A13 13 0 0 1 14.828 8q-.086.13-.195.288c-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5s-3.879-1.168-5.168-2.457A13 13 0 0 1 1.172 8z" />
                                        <path
                                            d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0" />
                                    </svg>
                        </a>
                        {{else}} <code>X</code>{{/if}}
                    </div>
                    <div class="col-2 card">
                        Certificado{{#if formando.certificado}} 
