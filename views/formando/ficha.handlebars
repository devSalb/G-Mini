{{#if formando.candidato}}
{{#if formando.masculino}}

<div class="text-center display-5 mt-5">Bem Vindo {{formando.nome}} </div>
{{else}}
<div class="text-center display-5 mt-5">Bem Vinda {{formando.nome}} </div>
{{/if}}
<hr class="my-4">
<div class="text-success text-center display-6 mb-5">A tua Candidatura está sendo analisada...</div>
<hr class="my-4">

{{!-- Area para carregar documentos --}}
<div class="card card-body text-center">
    <div class="row">
        <div class="col-4">
            <span class="fw-bold">Fotografia</span> <br>
            <hr>
            {{#if formando.foto}}
            <div class="text-center text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-check2"
                viewBox="0 0 16 16">
                <path
                    d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0" />
            </svg>
            </div>
            {{else}}
            <form action="/pedagogico/carregarfoto" method="post" enctype="multipart/form-data">
                <input type="file" name="foto" class="form-control">
                <input type="hidden" name="idFormando" value="{{formando._id}}">
                <button type="submit" class="btn btn-sm btn-secondary form-control">Guardar</button>
            </form>
            
            {{/if}}

        </div>

        <div class="col-4">
            <span class="fw-bold">Bilhete de Identidade</span> <br>
            <hr>
            {{#if formando.bilhete}}
            <div class="text-center text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-check2"
                viewBox="0 0 16 16">
                <path
                    d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0" />
            </svg>
            </div>
            {{else}}
            <form action="/pedagogico/carregarBI" method="post" enctype="multipart/form-data">
                <input type="file" name="bilhete" class="form-control">
                <input type="hidden" name="idFormando" value="{{formando._id}}">
                <button type="submit" class="btn btn-sm btn-secondary form-control">Guardar</button>
            </form>
            
            {{/if}}

        </div>

        <div class="col-4">
            <span class="fw-bold">Certificado</span> <br>
            <hr>
            {{#if formando.certificado}}
            <div class="text-center text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-check2"
                viewBox="0 0 16 16">
                <path
                    d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0" />
            </svg>
            </div>
            {{else}}
            <form action="/pedagogico/carregarCertificado" method="post" enctype="multipart/form-data">
                <input type="file" name="certificado" class="form-control">
                <input type="hidden" name="idFormando" value="{{formando._id}}">
                <button type="submit" class="btn btn-sm btn-secondary form-control">Guardar</button>
            </form>
            
            {{/if}}
        </div>
