<div class="container mt-4">
    <div class="row">
        {{!-- Grafico 1 --}}
        <div class="col-3 bg-light py-4 card ms-4 bt-1">
            <p class="subSize-1 text-center"><a href="/modelosMinipauta" class="nav-link">Modelos de Minipautas</a></p>


        </div>
        <div class="col-8 bg-light py-4 card ms-4 bt-1">
            <p class="subSize-1"><a href="#" onclick="avaliacao()" class="nav-link">Criar avaliações para alunos/estudantes</a></p>

        </div>


    </div>
</div>


{{!-- M O D A I S --}}

<!-- Modal cadastrarse-->

<div class="modal" tabindex="-1" data-bs-backdrop="static" id="avaliacao">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Criar avaliação</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="#" method="post" class="p-3">
                <div class="text-center lead p-3 text-danger">
                    Lamentamos! <br>
                    No momento não é possível efectuar esta operação.
                </div>


                <div class=" text-center mt-3">
                    <input type="hidden" name="formandoNoCentro" value="não">
                    {{!-- <button type="submit" class="btn btn-sm btn-primary form-control">Continuar</button> --}}
                    <button type="button" class="btn btn-secondary btn-sm mt-2 form-control"
                        data-bs-dismiss="modal">Cancelar</button>

                </div>
            </form>
        </div>
    </div>
</div>


<script src="assets/bootstrap.bundle.min.js" class="img-fluid"></script>
<script>
    function avaliacao() {
        let el = document.getElementById('avaliacao');
        let minha_modal = new bootstrap.Modal(el);
        minha_modal.show();
    }

</script>