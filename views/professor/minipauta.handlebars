{{else}}
{{/if}}
<div class="row">
    <div class="col-5 bg-secondary text-light py-3 mx-1">
        <h3>Professor: {{minipauta.idProfessor.nome}} </h3>
    </div>
    <div class="col-6 text-center p-2 mark">
        <h1><span class="text-secondary">Minipauta:</span> / {{minipauta.classe}}</h1>

    </div>
</div>
<hr>
<div class="bg-secondary">
    <div class="row">

        <div class="col-11">
            {{#if lancarNota}}
            <a href="/professor/minipautas/{{minipauta.idProfessor._id}}"><button
                    class=" btn btn-sm bg-laranja text-light">Ver todas minipautas</button> </a>
            {{else}}
            <a href="/pedagogico/minipautas"><button class=" btn btn-sm bg-laranja text-light">Ver todas
                    minipautas</button> </a>
            {{/if}}
            <span class="text-light text-center text-sm"> Veja e geri as notas dos teus alunos por meio desta planinha -
                > Realizar, no minimo duas avaliações por trimestre, copia sempre uma via</span>

        </div>

    </div>
</div>
<hr>
<div class="row mark h3 fw-bold">
    <div class="col-6">
        <span class="text-secondary">Turma: </span> <span> {{minipauta.turma}} </span>
    </div>
    <div class="col-6 text-end">
        <span class="text-secondary">Disciplina: </span> <span> {{minipauta.disciplina}} </span>
    </div>

</div>

{{!-- TABELA DA MINIPAUTA --}}
<div class="container p-0">
    <div class="row p-2">
        {{#if lancarNota}}
        <div class="text-danger text-center mark mb-3">Ilustre Docente; Adiciona todos alunos da turma
            {{minipauta.turma}} antes de lançar nota. Para lançar notas de todos, clica em "Lançar nota"
            Se for apenas de alguns alunos ou avaliação em atraso, clica no botão "Editar nota". <span class="fw-bold">
                O nome inserido depois do lançamento não aparece, mas podes lançar clicando em "Editar nota!</span>
        </div>
        <div class="row">
            <div class="col-9">

                <button onclick="lancarNota()" class="btn btn-sm btn-warning">Lançar nota</button>
                {{!-- <button onclick="lancarNota()" class="btn btn-sm btn-primary opacity-50">Lançar outra vez</button>
                --}}
                <span class="text-primary text-center">Depois do lançamento actualize a pagina por favor!</span>
            </div>
            <div class="col-3 text-end">
                {{!-- Funçãoque permite aos profe --}}
                <button onclick="editarNota()" class="btn btn-sm btn-warning">Editar nota / Av. Atraso</button>
            </div>
        </div>
        {{!-- PARA REPETIR LANÇAR --}}
        <form action="/professor/lancarNotaRep" method="post">

            {{#if msgFalhaLancada}}<div class="text-center">

                <input type="hidden" name="idProfessor" value="{{minipauta.idProfessor._id}}">
                <input type="hidden" name="idMinipauta" value="{{minipauta._id}}">
                <input type="hidden" name="idClasse" value="{{minipauta.idClasse._id}}">
                <input type="hidden" name="idTurma" value="{{minipauta.idTurma._id}}">
                <input type="hidden" name="idCurso" value="{{curso._id}}">
                <input type="hidden" name="idAno" value="{{ano._id}}">
                <button type="submit" class="p-1 btn btn-sm btn-danger"> {{msgFalhaLancada}} </button>
            </div>{{else}}{{/if}}
        </form>
        {{else}}
        <div class="row">
            <div class="col-3"><button onclick="editarNota()" class="btn btn-sm btn-warning">Editar nota / Av.
                    Atraso</button></div>
            <div class="col-7">
                {{#if msgFalhaLancada}}<div class="text-center"> <button class="p-1 btn btn-sm btn-danger"> Algumas
                        notas não foram salvas. O professor deve repetir o lançamento! {{msgFalhaLancada}} </button>
                </div>{{else}}{{/if}}
            </div>
            <div class="col-2 text-end">
                <button onclick="lancarNota()" class="btn btn-sm btn-danger opacity-50">At. nota Admin</button>
            </div>
        </div>
        {{/if}}


    </div>
    <table class="table table-bordered text-center table-sm p-0">
        <tbody>
            <thead class="table-dark">
                <tr class="fw-bold">
                    <td class=" text-center pb-4" rowspan="2">Nº</td>
                    <td class=" text-center pb-4" rowspan="2"> Nome completo </td>
                    <td class="text-center bg-light text-secondary" colspan="7">1º Trimestre</td>
                    <td class="text-center bg-info" colspan="7">2º Trimestre</td>
                    <td class="text-center bg-secondary" colspan="7">3º Trimestre</td>
                    <td class="text-center bg-dark" colspan="3">CF</td>
                </tr>
                <tr>

                    <td class="bg-light text-secondary">1ª Av</td>
