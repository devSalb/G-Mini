                    <td class="bg-light text-secondary">PP</td>
                    <td class="bg-light text-secondary">PT1</td>
                    <td class="bg-light text-secondary">MT1</td>

                    {{!-- 2º Trimwstre --}}
                    <td class="bg-info">1ª Av</td>
                    <td class="bg-info">2ª Av</td>
                    <td class="bg-info">3ª Av</td>
                    <td class="bg-info">MAC2</td>
                    <td class="bg-info">PP</td>
                    <td class="bg-info">PT2</td>
                    <td class="bg-info">MT2</td>

                    {{!-- 3º Trimwstre --}}
                    <td class="bg-secondary">1ª Av</td>
                    <td class="bg-secondary">2ª Av</td>
                    <td class="bg-secondary">3ª Av</td>
                    <td class="bg-secondary">MAC3</td>
                    <td class="bg-secondary">PP</td>
                    <td class="bg-secondary">PT3</td>
                    <td class="bg-secondary">MT3</td>


                    <td>MT</td>
                    <td>E</td>
                    <td>CF</td>


                </tr>
            </thead>
            {{#each notasDisciplina}}

            <ol class="m-0 p-0">

                <tr>
                    <td class="text-center bg-secondary"><span class="mx-0"> {{numeroOrd}} </span></td>

                    <td class="text-start"><span class="text-sm"> {{aluno.nome}} </span> </td>
                    {{!-- 1º Trimwstre --}}
